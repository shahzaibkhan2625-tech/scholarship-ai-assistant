# Neon (managed Postgres) connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Qdrant Cloud connection details
QDRANT_URL=https://your-cluster-id.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# Secret key used to sign JWT access tokens (auth)
JWT_SECRET_KEY=change-me-to-a-random-secret

# Local-filesystem root for uploaded/generated document storage (optional;
# defaults to backend/data/storage)
STORAGE_ROOT=./backend/data/storage
