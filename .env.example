# Neon (managed Postgres) connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Qdrant Cloud connection details
QDRANT_URL=https://your-cluster-id.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# Google Gemini API key (LLM calls)
GEMINI_API_KEY=your-gemini-api-key

# Secret key used to sign JWT access tokens (auth)
JWT_SECRET_KEY=change-me-to-a-random-secret

# Owner/direct database URL for Alembic ONLY (010). Pass it to the one-off migration command
# (e.g. podman run --rm -e MIGRATION_DATABASE_URL=...); never store it in the VM's .env.
# Leave empty here; when unset, migrations use DATABASE_URL.
MIGRATION_DATABASE_URL=

# Upload size cap in bytes (default 10 MiB) and redirect hops followed by the safe fetch (010; defaults shown)
MAX_UPLOAD_BYTES=10485760
MAX_FETCH_REDIRECTS=5

# Local-filesystem root for uploaded/generated document storage (optional;
# defaults to backend/data/storage)
STORAGE_ROOT=./backend/data/storage

# Alert email delivery (all optional; leave unset to disable email alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERTS_FROM_EMAIL=

# Source monitoring + hardening (all optional; defaults shown)
MONITORING_INTERVAL_MINUTES=60
FETCH_LOG_RETENTION_DAYS=90
HEALTH_WINDOW_N=5
RATE_LIMIT_PER_MINUTE=120
CANDIDATE_VALIDATION_RECHECK_DAYS=7
MAX_CANDIDATE_VALIDATIONS_PER_RUN=15

# STORAGE_ROOT above is also the volume-mount target for container deploys
# (e.g. /data/storage); no change to the existing STORAGE_ROOT line.

# Public IP or hostname Caddy serves (docker-compose.podman.yml; defaults to the VM IP).
# With no domain, Caddy uses `tls internal` (browser warning) - see docs/operations-hardening.md.
SITE_ADDRESS=
